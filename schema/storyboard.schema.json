{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StoryboardSchema",
  "type": "object",
  "required": [
    "schema_version",
    "project_title",
    "target_duration_seconds",
    "aspect_ratios",
    "language",
    "subtitle_language",
    "style_block",
    "characters",
    "music",
    "shots",
    "end_card"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "project_title": {
      "type": "string"
    },
    "target_duration_seconds": {
      "type": "integer",
      "minimum": 1
    },
    "aspect_ratios": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "language": {
      "type": "string"
    },
    "subtitle_language": {
      "type": "string"
    },
    "style_block": {
      "type": "string"
    },
    "characters": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "name",
          "description"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "music": {
      "type": "object",
      "required": [
        "prompt",
        "bpm",
        "key",
        "duration_seconds",
        "instrumental"
      ],
      "properties": {
        "prompt": {
          "type": "string"
        },
        "bpm": {
          "type": "integer"
        },
        "key": {
          "type": "string"
        },
        "duration_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "instrumental": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "shots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "duration_seconds",
          "camera_shot",
          "purpose",
          "characters_in_shot",
          "character_refs",
          "seed",
          "use_video",
          "image_prompt",
          "motion_prompt",
          "narration",
          "subtitle",
          "music_cue"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^shot_[0-9]{2}$"
          },
          "duration_seconds": {
            "type": "integer",
            "minimum": 1
          },
          "camera_shot": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "characters_in_shot": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "character_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "seed": {
            "type": "integer"
          },
          "use_video": {
            "type": "boolean"
          },
          "image_prompt": {
            "type": "string"
          },
          "motion_prompt": {
            "type": "string"
          },
          "narration": {
            "type": "string"
          },
          "subtitle": {
            "type": "string"
          },
          "voice": {
            "type": "string"
          },
          "tts_style": {
            "type": "string"
          },
          "music_cue": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "end_card": {
      "type": "object",
      "required": [
        "duration_seconds",
        "text",
        "background",
        "font_size"
      ],
      "properties": {
        "duration_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "text": {
          "type": "string"
        },
        "background": {
          "type": "string"
        },
        "font_size": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
